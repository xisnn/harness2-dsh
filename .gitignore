# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# PEP 517 build isolation scratch, left behind when a build is interrupted
build-env-*/
pip-*/
build-requirements-*.txt

# Test and tool caches
.pytest_cache/
.ruff_cache/
# pytest's tmp_path root, when TMPDIR resolves beside the source tree
pytest-of-*/
.pytest-tmp/
.coverage
htmlcov/

# Generated bundles: these are build output, not source
/bundles/
/out/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
